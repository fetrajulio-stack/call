# ============================================================
#  Configuration de l'agent vocal — copier ce fichier en .env
#  Tout ce qui est secret ou personnel se met ICI, jamais dans le code.
# ============================================================

# --- Clé API Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Modèles Groq ---
# LLM : openai/gpt-oss-120b (recommandé), openai/gpt-oss-20b (plus rapide, moins bon), qwen/qwen3.8-27b (preview)
# Liste à jour des modèles accessibles avec ta clé : https://console.groq.com/docs/models
GROQ_LLM_MODEL=openai/gpt-oss-120b
# Effort de raisonnement des modèles gpt-oss : low (recommandé pour la voix), medium, high. Vide = défaut du modèle.
GROQ_REASONING_EFFORT=low
# STT : whisper-large-v3-turbo (rapide) ou whisper-large-v3 (plus précis)
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Voix française (synthèse vocale locale, gratuite) ---
# piper : léger (~60 Mo), prêt tout de suite. kokoro : meilleure qualité (~330 Mo téléchargés au 1er lancement).
TTS_PROVIDER=piper
# Voix : piper -> fr_FR-siwis-medium, fr_FR-upmc-medium, fr_FR-tom-medium ; kokoro -> ff_siwis
TTS_VOICE=fr_FR-siwis-medium
# Vitesse de parole (0.5 à 2.0)
TTS_SPEED=1.0
# Silence (en secondes) avant de considérer que l'appelant a fini sa phrase
VAD_STOP_SECS=0.7

# --- Identité (données personnelles) ---
# Prénom de l'assistante virtuelle
ASSISTANT_NAME=Léa
# Personne pour qui l'assistante répond
OWNER_NAME=Prénom Nom
# Nom de l'entreprise (optionnel, laisser vide sinon)
BUSINESS_NAME=
# Raison donnée à l'appelant (complète la phrase "OWNER_NAME ...")
OWNER_UNAVAILABLE_REASON=n'est pas disponible pour le moment

# --- Twilio (phase 2 : brancher un vrai numéro ; laisser vide pour l'instant) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
